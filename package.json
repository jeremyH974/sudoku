{
  "name": "sudoku-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force && svelte-check --workspace packages/app --threshold warning --fail-on-warnings",
    "lint": "eslint .",
    "measure": "vitest run --config vitest.perf.config.ts",
    "dev": "pnpm --filter @sudoku/app dev",
    "build": "pnpm --filter @sudoku/app build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "calibrate": "tsx packages/cli/src/main.ts",
    "diagnose": "tsx packages/cli/src/diagnose.ts",
    "dailies": "tsx packages/cli/src/dailies.ts",
    "lessons": "tsx packages/cli/src/lessons.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
